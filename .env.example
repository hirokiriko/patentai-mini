# App
APP_NAME=patent-prior-art-poc
NODE_ENV=development

# Storage
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# Database (Turso or local SQLite)
DATABASE_URL=file:./data/app.db
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# LLM (AI SDK)
AI_PROVIDER=google
# AI_MODEL=          # 省略時はプロバイダーのデフォルト (google: gemini-2.5-flash-preview-05-20, openai: gpt-4o)

# プロバイダーごとの API キー（使用するプロバイダーのみ設定）
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional vector db
VECTOR_BACKEND=sqlite
# examples: sqlite, pgvector, qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Feature flags
ENABLE_VECTOR_SEARCH=false
ENABLE_CLAIM_GRAPH=false
ENABLE_MANUAL_REVIEW_QUEUE=true
