# ===== 必須 =====

# Database (Turso URL または ローカル SQLite ファイルパス)
DATABASE_URL=file:./data/app.db
# DATABASE_URL=libsql://your-db.turso.io
# Turso 使用時のみ
# TURSO_AUTH_TOKEN=

# LLM API キー (AI_PROVIDER で選んだプロバイダーのみ必要)
# 現在コード側で対応: google / openai
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=

# ===== 任意 =====

# LLM プロバイダー切替 (google | openai)  — デフォルト: google
# AI_PROVIDER=google
# モデル名 — 省略時は各プロバイダーのデフォルト
# (google: gemini-2.5-flash-preview-05-20, openai: gpt-4o)
# AI_MODEL=
