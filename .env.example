# App
APP_NAME=patent-prior-art-poc
NODE_ENV=development

# Storage
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# Database
DATABASE_URL=file:./data/app.db

# LLM (AI SDK)
# AI SDK はプロバイダーごとの環境変数を自動認識する
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional vector db
VECTOR_BACKEND=sqlite
# examples: sqlite, pgvector, qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Feature flags
ENABLE_VECTOR_SEARCH=false
ENABLE_CLAIM_GRAPH=false
ENABLE_MANUAL_REVIEW_QUEUE=true
