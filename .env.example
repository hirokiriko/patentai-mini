# ===== Required =====

# Database (Postgres connection string)
# For Azure Database for PostgreSQL, include sslmode=require when needed.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# LLM API keys. Set the key for the selected AI_PROVIDER.
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=

# ===== Optional =====

# LLM provider selection: google | openai | azure. Default: google
# AI_PROVIDER=google

# Provider-specific default model override.
# Azure OpenAI uses deployment names below instead of AI_MODEL.
# AI_MODEL=

# Azure OpenAI (required when AI_PROVIDER=azure)
# Either AZURE_RESOURCE_NAME or AZURE_OPENAI_BASE_URL is required.
# AZURE_RESOURCE_NAME=
# AZURE_OPENAI_BASE_URL=
# AZURE_API_KEY=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_FAST_DEPLOYMENT_NAME=

# Runtime port for container platforms such as Azure Container Apps.
# PORT=3000

# Azure Blob Storage for original uploaded files.
# If both values are omitted, uploads keep the previous DB-only behavior.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER_NAME=

# Azure AI Document Intelligence for OCR/layout fallback.
# Used for scanned PDFs, garbled PDF text, and table-heavy DOCX files.
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Manual koho package import API. The endpoint stays disabled unless both are valid.
# Token must be at least 32 UTF-8 bytes. Do not commit an actual value.
# KOHO_IMPORT_ADMIN_TOKEN=
# Positive decimal source-byte limit, at most 64 GiB. Do not commit a runtime value.
# KOHO_IMPORT_MAX_SOURCE_BYTES=

# OWNER-only access; all business routes fail closed when any value is missing.
# Configure and verify ACA Easy Auth before exposing the container. No local header trust.
# OWNER_AUTH_MODE=azure-easy-auth
# OWNER_APP_ORIGIN=https://the-existing-app-origin
# OWNER_TENANT_ID=
# OWNER_OBJECT_ID=
# OWNER_CLIENT_ID=

# Managed watch service budget: installed bindings, never request-selected values.
# Reuses the existing private container. Do not set these before reviewed setup.
# MANAGED_BUDGET_STORAGE_ACCOUNT=
# MANAGED_BUDGET_CONTAINER=
# MANAGED_BUDGET_TARGET_SHA256=
# MANAGED_BUDGET_OWNER_SHA256=
# New delivery/backup/recovery only: approved RELEASE_V1 or post-GO STANDARD_V1.
# MANAGED_ARTIFACT_APPROVAL=STANDARD_MANAGED_WATCH_RELEASE_V1
# Optional existing user-assigned identity; omit for the existing system identity.
# MANAGED_BUDGET_IDENTITY_CLIENT_ID=
# Ed25519 SPKI public key (base64) and its independently installed SHA256 pin.
# The private signing key belongs only to the separate Local review process.
# MANAGED_BUDGET_REVIEW_PUBLIC_KEY=
# MANAGED_BUDGET_REVIEW_KEY_SHA256=
# Install only after independent STANDARD_MANAGED_WATCH_PRODUCTION_GO acceptance.
# MANAGED_BUDGET_PRODUCTION_GO_SHA256=
