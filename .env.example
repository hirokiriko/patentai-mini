# App
APP_NAME=patent-prior-art-poc
NODE_ENV=development

# Storage
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# Database
DATABASE_URL=file:./data/app.db

# Embeddings / LLM
OPENAI_API_KEY=
EMBEDDING_MODEL=
CHAT_MODEL=

# Optional vector db
VECTOR_BACKEND=sqlite
# examples: sqlite, pgvector, qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Feature flags
ENABLE_VECTOR_SEARCH=false
ENABLE_CLAIM_GRAPH=false
ENABLE_MANUAL_REVIEW_QUEUE=true
